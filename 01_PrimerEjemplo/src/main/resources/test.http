### POST Crear categoría
POST http://localhost:8080/api/category
Content-Type: application/json

{
  "name": "Bebidas"
}

### POST Crear categoría - Error 1 (Nombre vacío)
POST http://localhost:8080/api/category
Content-Type: application/json

{
  "name": ""
}

### POST Crear categoría - Error 2 (Nombre nulo)
POST http://localhost:8080/api/category
Content-Type: application/json

{
  "name": null
}

### GET obtener todas las categorías
GET http://localhost:8080/api/category

### GET obtener categoría id 1
GET http://localhost:8080/api/category/1

### PUT Modificar categoría
PUT http://localhost:8080/api/category/1
Content-Type: application/json

{
  "name": "Bebidas Frías y Refrescos"
}

### DELETE borrar categoría id 1
DELETE http://localhost:8080/api/category/1


### POST Crear producto
POST http://localhost:8080/api/product
Content-Type: application/json

{
  "name": "Pan y picos",
  "price": 1,
  "details": "Servicio de mesa"
}

### POST Crear producto - Error 1
POST http://localhost:8080/api/product
Content-Type: application/json

{
  "name": "",
  "price": 1,
  "details": "Servicio de mesa"
}

### POST Crear producto - Error 2
POST http://localhost:8080/api/product
Content-Type: application/json

{
  "name": "Pan y picos",
  "price": -1,
  "details": "Servicio de mesa"
}


### POST Crear producto - Error 3
POST http://localhost:8080/api/product
Content-Type: application/json

{
  "name": "Pan y picos",
  "price": 1,
  "details": null
}

### GET obtener todos los productos
GET http://localhost:8080/api/product

### GET obtener producto id 1
GET http://localhost:8080/api/product/1


### PUT Modificar producto
PUT http://localhost:8080/api/product/1
Content-Type: application/json

{
  "name": "Pan y picos",
  "price": -13,
  "details": "Servicio de mesa por persona"
}

### DELETE borrar producto id 1
DELETE http://localhost:8080/api/product/1